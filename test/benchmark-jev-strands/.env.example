# test/benchmark-jev-strands/.env.example
#
# Copy to `.env` in this directory and fill in what you need. run.sh loads it
# automatically (a variable already set in your shell wins over this file).
# Every key is optional — with none set, the benchmark runs against the bundled
# mock servers.

# ── jev (cloud) ─────────────────────────────────────────────────────────────
# Set a real key to benchmark the live jev API instead of the mock.
# JEV_API_KEY=sk-...
# Override the jev base URL (defaults to https://api.typesafe.ai when a key is
# set, or the local mock on :8842 when it isn't).
# JEV_BASE_URL=https://api.typesafe.ai

# ── strands-decider (local) ─────────────────────────────────────────────────
# Point at the strands server to benchmark. If this is a localhost URL and
# nothing is listening there, run.sh will auto-start `strands-decider serve`
# (requires `pip install strands-decider`) and stop it when the run finishes.
STRANDS_BASE_URL=http://127.0.0.1:8000
# Checkpoint/model id used for auto-start.
# STRANDS_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
# Set to 0 to never auto-start (you must have the server running yourself).
# STRANDS_AUTOSTART=1
