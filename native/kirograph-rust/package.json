{
  "name": "kirograph-rust",
  "version": "1.5.3",
  "description": "Native indexing engine for KiroGraph (engine: \"rust\")",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "kirograph_rust",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "grammar-sources": "node ../../scripts/grammars.mjs sources",
    "build": "node ../../scripts/grammars.mjs sources && napi build --platform --release --no-js --dts target/napi.d.ts",
    "build:debug": "node ../../scripts/grammars.mjs sources && napi build --platform --no-js --dts target/napi.d.ts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3"
  }
}
